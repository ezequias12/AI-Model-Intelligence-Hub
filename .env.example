# =============================================================================
# AI Model Intelligence Hub — environment template
# Copy to `.env.local` and fill in. NEVER commit real values.
# =============================================================================

# --- Runtime mode -----------------------------------------------------------
# mock = deterministic fixtures, no credentials required (default)
# live = real adapters; missing optional integrations degrade gracefully
NEXT_PUBLIC_DATA_MODE=mock

# Public site URL (used for canonical/shareable links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Artificial Analysis Data API -------------------------------------------
# Server-side only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
ARTIFICIAL_ANALYSIS_API_KEY=
ARTIFICIAL_ANALYSIS_BASE_URL=https://artificialanalysis.ai/api/v2

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- QStash (scheduled ingestion) -------------------------------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=https://qstash.upstash.io
# Public base URL QStash calls back into (deployment URL or tunnel)
QSTASH_TARGET_BASE_URL=http://localhost:3000

# --- Optional: social / X ---------------------------------------------------
# Only used through authorized APIs. Never scrape X HTML as the foundation.
X_BEARER_TOKEN=

# --- Optional: LLM summaries ------------------------------------------------
# When absent, summaries degrade gracefully to source excerpts/metadata.
LLM_SUMMARY_API_KEY=
LLM_SUMMARY_MODEL=

# --- Optional: world/politics news provider ---------------------------------
WORLD_NEWS_API_KEY=
WORLD_NEWS_BASE_URL=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
